# Copie para .env.local (desenvolvimento) e cadastre as mesmas chaves nas
# Environment Variables do projeto na Vercel. Nunca commite valores reais.

# Token permanente da conta modelo (Ajustes > Integrações > Integração via API)
WTS_MODEL_TOKEN=pn_xxxxxxxxxxxxxxxx

# Senha de acesso à página
APP_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão (mín. 32 caracteres aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional: trecho da conta modelo no final das URLs dos webhooks
# (padrão: embarque22palmitos). Na cópia ele vira o identificador do cliente.
WEBHOOK_MODEL_SLUG=

# Montar prompt da IA (chave da API da Anthropic: console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcional: botão "Criar no n8n" (sem isso, só download/copiar JSON)
N8N_BASE_URL=
N8N_API_KEY=
