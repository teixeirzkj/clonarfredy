    {
      "parameters": {
        "jsCode": "// Rotativo pelo sistema: quem está ligado = usuários da equipe \"Rotativo\" no WTS\n// (liga/desliga na tela Rotativo do Setup da Conta). A ordem e o nome de cada um\n// (o que vai no \"nome atendente\") vieram da página.\nconst ORDEM = [\"__ORDEM_ROTATIVO__\"];\n\nconst equipe = $('Buscar equipe Rotativo').first().json;\nconst ligados = new Set((equipe.agents || []).map((a) => a.userId));\nconst nomesWts = Object.fromEntries($('Buscar usuários').all().map((i) => [i.json.userId, i.json.name]));\nconst nomeNoRodizio = Object.fromEntries(ORDEM.map((o) => [o.id, o.nome]));\nconst ids = ORDEM.map((o) => o.id);\nconst nome = (id) => nomeNoRodizio[id] || nomesWts[id];\n\n// Na ordem escolhida; quem foi ligado depois entra no fim, com o nome do usuário.\nconst fila = [\n  ...ids.filter((id) => ligados.has(id)),\n  ...[...ligados].filter((id) => !ids.includes(id)).sort((a, b) => String(nome(a)).localeCompare(String(nome(b)))),\n].filter((id) => nome(id));\nif (!fila.length) throw new Error('Ninguém ligado no rotativo: ligue alguém na tela Rotativo do Setup da Conta.');\n\n// A vez fica guardada no próprio fluxo (só com o fluxo ativo; no teste manual começa do primeiro).\nconst memoria = $getWorkflowStaticData('global');\nconst proximo = fila[(fila.indexOf(memoria.ultimo) + 1) % fila.length];\nmemoria.ultimo = proximo;\n\nreturn [{ json: { userId: proximo, nome: nome(proximo), posicao: fila.indexOf(proximo) + 1, total: fila.length } }];\n"
      },
